{
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "[HH:mm:ss.ff] "
      }
    },
    "File": {
      "MinLevel": "Information",
      "FileSizeLimitBytes": 44040192 // 42 MiB
    },
    "LogLevel": {
      "*": "Information"
    }
  },
  "MiaoServer": {
    "Network": {
      "ListenEndpoint": "0.0.0.0:21473"
    },
    "Certificate": {
      "CertificatePath": null,
      "CertificateKeyPath": null
    },
    "Authentication": {
      "ClientID": null,
      "ClientSecret": null,
      "EncryptionPassword": null
    },
    "HandshakeTimeout": 6000,
    "PingPeriod": 4000,
    "HeartbeatTimeoutThreshold": 15000,
    "DisconnectTimeout": 3000,
    "HttpListenerPrefix": "http://localhost:21474/",
    // 管理类 HTTP 接口(DELETE /player、POST /announce、/gc)所需的 X-Api-Token, 为空则不校验(启动时会有警告)
    "ApiToken": "",
    // 管理后台(通过论坛 OAuth 登录, 仅论坛管理员可访问)
    "AdminPanel": {
      "Enabled": false,
      "ForumBaseUrl": "https://bbs.celemiao.com",
      "ClientID": null,
      "ClientSecret": null,
      "RedirectUri": "http://localhost:21474/admin/callback",
      "SessionHours": 12,
      "DebugSkipAuth": false
    }
  }
}