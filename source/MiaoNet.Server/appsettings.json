{
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "[HH:mm:ss.ff] "
      }
    },
    "File": {
      "MinLevel": "Information",
      "FileSizeLimitBytes": 44040192
    },
    "LogLevel": {
      "*": "Information"
    }
  },
  "MiaoServer": {
    "Network": {
      "ListenEndPoint": "0.0.0.0:21473",
      "HandshakeTimeout": 6000,
      "PingPeriod": 4000,
      "HeartbeatTimeoutThreshold": 15000,
      "DisconnectTimeout": 3000,
      "RequestTimeout": 10000,
      "SendBatchFrequency": 60,
      "SendBatchSize": 1344
    },
    "Certificate": {
      "CertificatePath": null,
      "CertificateKeyPath": null
    },
    "Authentication": {
      "ClientID": null,
      "ClientSecret": null,
      "EncryptionPassword": null
    },
    "Http": {
      "ListenerPrefix": "http://localhost:21474/"
    }
  }
}
