{
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "[HH:mm:ss.ff] "
      }
    },
    "File": {
      "MinLevel": "Information",
      "FileSizeLimitBytes": 44040192 // 42 MiB
    },
    "LogLevel": {
      "*": "Information"
    }
  },
  "MiaoServer": {
    "ListenIPEndpoint": "0.0.0.0:21473",
    "HandshakeTimeout": 3000,
    "ExpectedVersion": "0.2.0",
    "PingPeriod": 400,
    "HeartbeatTimeoutThreshold": 10000,
    "DisconnectTimeout": 3000,
    "CertificatePath": null,
    "CertificateKeyPath": null,
    "HttpListenerPrefix": "http://+:8000/"
  }
}