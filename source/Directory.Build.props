<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRootDirectory>$(MSBuildThisFileDirectory)</ProjectRootDirectory>
    <PathMap Condition="$(Configuration)=='Release'">$(ProjectRootDirectory)=~/</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

</Project>