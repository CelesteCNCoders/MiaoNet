namespace MiaoNet.Shared;

public sealed class OnlinePlayer
{
    public OnlineChannel Channel { get; }

    public PlayerInfo Info { get; }

    public int ID => Info.ID;

    public PlayerStateInfo StateInfo { get; }

    public PlayerGraphicsInfo

    // TODO any better way to do this?
#if MIAO_SERVER
    public Server.MiaoClientConnection Connection { get; set; } = null!;
#endif

    public OnlinePlayer(OnlineChannel channel, PlayerInfo initialPlayerInfo, PlayerStateInfo initialStateInfo)
    {
        Channel = channel;
        Info = initialPlayerInfo.Clone();
        StateInfo = initialStateInfo;
    }

    public ChannelPlayerStateInfo GetChannelPlayerStateInfo()
        => new(Channel.ID, Info, StateInfo);

    public override string ToString()
        => $"Player-{Info.Name}:{Info.ID}";
}