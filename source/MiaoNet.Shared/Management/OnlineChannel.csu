using System.Diagnostics;
using System.Runtime.CompilerServices;

namespace MiaoNet.Shared;

public sealed class OnlineChannel
{
    private readonly List<OnlinePlayer> players;

    public OnlineContext Context { get; }

    public int ID { get; }

    public string Name { get; }

    public IReadOnlyList<OnlinePlayer> Players => players;

    public OnlineChannel(OnlineContext context, ChannelStateInfo initialStateInfo)
    {
        Context = context;
        players = new();
        ID = initialStateInfo.ID;
        Name = initialStateInfo.Name;
    }

    public void AddPlayer(OnlinePlayer onlinePlayer)
        => players.Add(onlinePlayer);

    public bool RemovePlayer(OnlinePlayer onlinePlayer)
        => players.Remove(onlinePlayer);

    public override string ToString()
        => $"{Name}:{ID}";
}