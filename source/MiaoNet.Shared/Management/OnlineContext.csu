using System.Diagnostics;

namespace MiaoNet.Shared;

public sealed class OnlineContext
{
#if MIAO_CLIENT
    public OnlinePlayer Self { get; private set; }
#endif
    public List<OnlinePlayer> Players { get; private set; }
    public List<OnlineChannel> Channels { get; private set; }

#if MIAO_CLIENT
    public OnlineContext(ChannelStateInfo joinedChannel, ChannelPlayerStateInfo selfInfo)
    {
        Players = new();
        Channels = [new(this, joinedChannel)];
        Self = AddPlayer(selfInfo);
    }
#elif MIAO_SERVER
    public OnlineContext(ChannelStateInfo mainChannel)
    {
        Players = new();
        Channels = [new(this, mainChannel)];
    }
#endif

    public void AddPlayer(OnlinePlayer player)
    {
        Players.Add(player);
        player.Channel.AddPlayer(player);
    }

    public OnlinePlayer AddPlayer(ChannelPlayerStateInfo info)
    {
        OnlineChannel channel = GetChannel(info.ChannelID);
        OnlinePlayer player;
        Players.Add(player = new(channel, info.Info, info.StateInfo));
        channel.AddPlayer(player);
        return player;
    }

    public void RemovePlayer(int playerID)
    {
        var player = GetPlayer(playerID);
        bool result = Players.Remove(player);
        result &= player.Channel.RemovePlayer(player);
        Debug.Assert(result);
    }

    // TODO optimize?
    public OnlinePlayer GetPlayer(int playerID)
        => Players.Single(p => p.Info.ID == playerID);

    public OnlineChannel GetChannel(int channelID)
        => Channels.Single(c => c.ID == channelID);
}