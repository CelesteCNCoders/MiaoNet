<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);MIAO_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiaoNet.Server\MiaoNet.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chat 数据模型与编辑内核（XNA-free；客户端也从这里编译同一批源码）。 -->
    <Compile Include="..\MiaoNet.Client\Chat\**\*.cs" LinkBase="0-Shared/Chat" />
    <Compile Include="..\MiaoNet.Client\Command\CommandParser.cs" LinkBase="0-Shared/Command" />
    <Compile Include="..\MiaoNet.Client\Command\CommandSegmentType.cs" LinkBase="0-Shared/Command" />
    <Compile Include="..\MiaoNet.Client\Command\MiaoNetCommand.cs" LinkBase="0-Shared/Command" />
    <Compile Include="..\MiaoNet.Client\Misc\SR.cs" LinkBase="0-Shared/Command" />
    <Compile Include="..\MiaoNet.Client\Misc\PFormat.cs" LinkBase="0-Shared" />
    <Compile Include="..\MiaoNet.ClientShared\ConnectionLifecycleCoordinator.cs" LinkBase="0-Shared" />
    <Compile Include="..\MiaoNet.ClientShared\BestEffortCleanup.cs" LinkBase="0-Shared" />
    <Compile Include="..\MiaoNet.Shared\SafeGuard.cs" LinkBase="0-Shared/Command" />

    <!--
      UI layout core. These sources must stay free of XNA / Celeste types, otherwise this
      project (which does not reference Celeste) cannot compile them.
    -->
    <Compile Include="..\MiaoNet.Client\UI\Geometry\**\*.cs" LinkBase="0-Shared/UI/Geometry" />
    <Compile Include="..\MiaoNet.Client\UI\Layout\**\*.cs" LinkBase="0-Shared/UI/Layout" />
    <Compile Include="..\MiaoNet.Client\UI\Scene\**\*.cs" LinkBase="0-Shared/UI/Scene" />
    <Compile Include="..\MiaoNet.Client\UI\Styling\**\*.cs" LinkBase="0-Shared/UI/Styling" />
    <Compile Include="..\MiaoNet.Client\UI\Controls\**\*.cs" LinkBase="0-Shared/UI/Controls" />
    <Compile Include="..\MiaoNet.Client\UI\PlayerList\**\*.cs" LinkBase="0-Shared/UI/PlayerList" />
    <Compile Include="..\MiaoNet.Client\UI\Chat\**\*.cs" LinkBase="0-Shared/UI/Chat" />
    <Compile Include="..\MiaoNet.Client\UI\Input\**\*.cs" LinkBase="0-Shared/UI/Input" />
    <Compile Include="..\MiaoNet.Client\UI\Status\**\*.cs" LinkBase="0-Shared/UI/Status" />
    <Compile Include="..\MiaoNet.Client\UI\DebugMap\**\*.cs" LinkBase="0-Shared/UI/DebugMap" />
    <Compile Include="..\MiaoNet.Client\UI\Rendering\IUICanvas.cs" LinkBase="0-Shared/UI/Rendering" />
    <Compile Include="..\MiaoNet.Client\UI\Rendering\ITextRenderer.cs" LinkBase="0-Shared/UI/Rendering" />
    <Compile Include="..\MiaoNet.Client\UI\Rendering\IUITexture.cs" LinkBase="0-Shared/UI/Rendering" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
